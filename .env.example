# Gemini API Key — image generation (UGC Studio + Pinterest image creation)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Claude API Key — Pinterest research & content generation
# Get yours at https://console.anthropic.com/
CLAUDE_API_KEY=

# Pinterest OAuth Access Token — publishing pins directly to your boards
# Generate at https://developers.pinterest.com/
PINTEREST_ACCESS_TOKEN=

# Amazon Associates affiliate tag (e.g. yourbrand-20)
# Get yours at https://affiliate-program.amazon.com/
AMAZON_AFFILIATE_TAG=
