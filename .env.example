# Gemini API Key — image generation (UGC Studio + Pinterest image creation)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Claude API Key — Pinterest research & content generation
# Get yours at https://console.anthropic.com/
CLAUDE_API_KEY=

# Pinterest OAuth Access Token — fallback for manually pasting a token.
# Not needed if you set up the one-click "Connect Pinterest" flow below.
PINTEREST_ACCESS_TOKEN=

# Pinterest App credentials — enables the one-click "Connect Pinterest" OAuth flow.
# Create an app at https://developers.pinterest.com/apps/ and add your deployed
# app's URL (e.g. https://yourapp.vercel.app/) as an authorized redirect URI.
# PINTEREST_CLIENT_ID is bundled into the frontend (safe, it's a public identifier).
# PINTEREST_CLIENT_SECRET is used only by the /api/pinterest-oauth serverless
# function and must never be exposed to the browser — set it as a server-only
# environment variable in your hosting provider (e.g. Vercel project settings).
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Amazon Associates affiliate tag (e.g. yourbrand-20)
# Get yours at https://affiliate-program.amazon.com/
AMAZON_AFFILIATE_TAG=
